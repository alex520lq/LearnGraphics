{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": []
  },
  "include": ["LABS/**/*.js", "EXERCISES/**/*.js", "PROJECTS/**/*.js"],
  "exclude": ["node_modules", "**/node_modules/**"]
}
